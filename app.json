{
  "expo": {
    "name": "Fairshare",
    "slug": "fairshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Fairshare \u2014 expenses, together"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.fairshare.mobile"
    },
    "android": {
      "package": "app.fairshare.mobile"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a receipt to share with your group."
        }
      ],
      "expo-secure-store",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 25,
            "compileSdkVersion": 36
          }
        }
      ]
    ],
    "scheme": "fairshare"
  }
}
