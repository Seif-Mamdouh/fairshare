# Neon pooled PostgreSQL URL, required in Vercel. Never use EXPO_PUBLIC_ for secrets.
DATABASE_URL=
# Local development may use the embedded PostgreSQL engine instead.
LOCAL_DATABASE_PATH=./work/database
# Native Expo clients need your backend URL. Web defaults to its own origin.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Exact comma-separated web origins; default supports local Expo web.
ALLOWED_ORIGINS=http://localhost:8081
PORT=3001

# Read-only US bank linking. All values below are server-only unless stated otherwise.
# Leave absent until Plaid account setup is complete; never prefix secrets EXPO_PUBLIC_.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Exactly 32 cryptographically random bytes, encoded as base64; independent of Plaid keys.
BANK_TOKEN_ENCRYPTION_KEY=
# Set true only after Plaid confirms Link events for non-Hosted SDK sessions.
PLAID_LINK_EVENTS_ENABLED=false
PLAID_WEB_REDIRECT_URI=https://fairshare-five-chi.vercel.app/
# Native activation additionally requires signed/rebuilt apps and real-device OAuth verification.
PLAID_ANDROID_PACKAGE_NAME=app.fairshare.mobile
PLAID_IOS_REDIRECT_URI=https://fairshare-five-chi.vercel.app/bank-oauth
APPLE_TEAM_ID=
# Native build-time only: enables the iOS associated-domain entitlement.
BANK_IOS_CALLBACK_HOST=fairshare-five-chi.vercel.app
