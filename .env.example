# Neon pooled PostgreSQL URL, required in Vercel. Never use EXPO_PUBLIC_ for secrets.
DATABASE_URL=
# Local development may use the embedded PostgreSQL engine instead.
LOCAL_DATABASE_PATH=./work/database
# Native Expo clients need your backend URL. Web defaults to its own origin.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Exact comma-separated web origins; default supports local Expo web.
ALLOWED_ORIGINS=http://localhost:8081
PORT=3001

# Read-only US bank linking. All values below are server-only unless stated otherwise.
# Leave absent until Plaid account setup is complete; never prefix secrets EXPO_PUBLIC_.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Exactly 32 cryptographically random bytes, encoded as base64; independent of Plaid keys.
BANK_TOKEN_ENCRYPTION_KEY=
# Required true for Production bank data after Plaid enables Link events.
# Sandbox works with false using the SDK callback and an owned server session.
PLAID_LINK_EVENTS_ENABLED=false
# Local Sandbox: leave empty (nothing to register; OAuth test banks open in a pop-up), or use
# http://localhost:8081/ (npm run dev) / http://localhost:3001/ (npm run preview) after adding that exact
# URI to the Plaid dashboard's Allowed redirect URIs. Hosted: https://fairshare-five-chi.vercel.app/
PLAID_WEB_REDIRECT_URI=
# Native activation additionally requires signed/rebuilt apps and real-device OAuth verification.
PLAID_ANDROID_PACKAGE_NAME=app.fairshare.mobile
PLAID_IOS_REDIRECT_URI=https://fairshare-five-chi.vercel.app/bank-oauth
APPLE_TEAM_ID=
# Native build-time only: enables the iOS associated-domain entitlement.
BANK_IOS_CALLBACK_HOST=fairshare-five-chi.vercel.app

# Canonical public OAuth issuer origin. No trailing path; never derive this from request headers.
# Local preview defaults to http://localhost:$PORT instead.
OAUTH_ISSUER_URL=https://fairshare-five-chi.vercel.app

# Local Plaid Sandbox bank linking needs only PLAID_ENV=sandbox, PLAID_CLIENT_ID, PLAID_SECRET and
# BANK_TOKEN_ENCRYPTION_KEY above. Leave the native/iOS values empty unless you build native apps.
# Verify without a browser: npm run bank:sandbox-check (see docs/BANKING.md, "Local Sandbox setup").
