# Neon pooled PostgreSQL URL, required in Vercel. Never use EXPO_PUBLIC_ for secrets.
DATABASE_URL=
# Local development may use the embedded PostgreSQL engine instead.
LOCAL_DATABASE_PATH=./work/database
# Native Expo clients need your backend URL. Web defaults to its own origin.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Exact comma-separated web origins; default supports local Expo web.
ALLOWED_ORIGINS=http://localhost:8081
PORT=3001
# Phone sign-in stays disabled until a real Twilio Verify service is configured.
# Server-only secrets. Never expose these through EXPO_PUBLIC_ variables.
PHONE_AUTH_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Allowed country calling codes. Restrict to your actual users and provider geo-permissions.
PHONE_AUTH_COUNTRY_CODES=1
