{
  "openapi": "3.1.0",
  "info": {
    "title": "Fairshare Agent API",
    "version": "2.1.0",
    "description": "Group-scoped receipt submission for any agent provider. Human review required."
  },
  "servers": [
    {
      "url": "/api/v1/agent"
    }
  ],
  "security": [
    {
      "agentKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "agentKey": {
        "type": "http",
        "scheme": "bearer"
      },
      "workspaceCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "fairshare_session"
      },
      "workspaceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Private device session token for native and API clients"
      },
      "mcpOAuth": {
        "type": "oauth2",
        "description": "Browser approval for one owned group. S256 PKCE and the MCP resource indicator are required. Tokens are valid only at /api/mcp.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://fairshare-five-chi.vercel.app/api/oauth/authorize",
            "tokenUrl": "https://fairshare-five-chi.vercel.app/api/oauth/token",
            "refreshUrl": "https://fairshare-five-chi.vercel.app/api/oauth/token",
            "scopes": {
              "receipts": "Read group/member context, submit reviewed receipt drafts and read own receipt status"
            }
          }
        }
      }
    },
    "schemas": {
      "Receipt": {
        "type": "object",
        "required": [
          "sourceId",
          "title",
          "amountMinor",
          "currency",
          "paidBy",
          "spentOn",
          "splits"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "CAD",
              "AUD",
              "EGP"
            ]
          },
          "paidBy": {
            "type": "string"
          },
          "spentOn": {
            "type": "string",
            "format": "date"
          },
          "category": {
            "type": "string",
            "enum": [
              "Food & drink",
              "Groceries",
              "Transport",
              "Stay",
              "Shopping",
              "Other"
            ],
            "default": "Other"
          },
          "splits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "memberId",
                "amountMinor"
              ],
              "properties": {
                "memberId": {
                  "type": "string"
                },
                "amountMinor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                }
              },
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "imageData": {
            "type": "string",
            "maxLength": 1400000,
            "description": "PNG, JPEG, or WebP base64 data URL; max 1 MB decoded."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/context": {
      "get": {
        "operationId": "getGroupContext",
        "summary": "Read group currency and member IDs",
        "responses": {
          "200": {
            "description": "Group, members, agent, and capabilities"
          },
          "401": {
            "description": "Invalid or revoked key"
          }
        },
        "description": "An authenticated request verifies that this agent can reach Fairshare and records its last contact time. Minting a key or checking status in the web app does not mark it connected."
      }
    },
    "/receipts": {
      "post": {
        "operationId": "submitReceipt",
        "summary": "Submit an idempotent receipt draft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Receipt"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New pending receipt"
          },
          "200": {
            "description": "Identical replay"
          },
          "400": {
            "description": "Invalid fields, currency, members, image, or split total"
          },
          "401": {
            "description": "Invalid or revoked key"
          },
          "409": {
            "description": "Source ID reused with different content"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/receipts/{id}": {
      "get": {
        "operationId": "getReceiptStatus",
        "summary": "Read this agent\u2019s receipt review status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt status and expense ID"
          },
          "404": {
            "description": "Receipt not found or belongs to another agent"
          }
        }
      }
    },
    "/api/workspace": {
      "post": {
        "summary": "Create or resume a private device workspace; a valid session preserves its existing identity",
        "security": [],
        "responses": {
          "200": {
            "description": "Existing session resumed and renewed for one year"
          },
          "201": {
            "description": "New empty private workspace and secure device session"
          },
          "429": {
            "description": "New-workspace rate limit exceeded"
          }
        }
      },
      "servers": [
        {
          "url": "/"
        }
      ]
    },
    "/api/me/name": {
      "post": {
        "summary": "Update this workspace display name and linked memberships",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated display name"
          },
          "401": {
            "description": "Private device session required"
          }
        },
        "security": [
          {
            "workspaceCookie": []
          },
          {
            "workspaceToken": []
          }
        ]
      },
      "servers": [
        {
          "url": "/"
        }
      ]
    },
    "/api/mcp": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "post": {
        "summary": "Hosted Streamable HTTP MCP",
        "operationId": "agentMcp",
        "description": "Stateless JSON-RPC MCP. Every request requires a Bearer OAuth access token or manual group agent key. Unauthorized responses advertise RFC 9728 discovery. OAuth uses S256 PKCE, dynamic client registration and explicit browser approval for one group. Accept must include application/json and text/event-stream. No persistent transport session. Existing receipt validation, isolation and human approval apply.",
        "parameters": [
          {
            "in": "header",
            "name": "MCP-Protocol-Version",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Negotiated MCP protocol version on subsequent requests"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "const": "2.0"
                  },
                  "id": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC result or error; tool failures have result.isError=true",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jsonrpc": {
                      "const": "2.0"
                    },
                    "id": {
                      "type": [
                        "string",
                        "integer",
                        "null"
                      ]
                    },
                    "result": {
                      "type": "object"
                    },
                    "error": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Accepted MCP notification"
          },
          "400": {
            "description": "Malformed MCP request, unsupported protocol version or query parameters"
          },
          "401": {
            "description": "Missing, invalid, expired or revoked credential",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer challenge with resource_metadata and receipts scope"
              }
            }
          },
          "403": {
            "description": "Origin not allowed"
          },
          "406": {
            "description": "Accept must include JSON and SSE"
          },
          "413": {
            "description": "Payload exceeds API body limit"
          },
          "415": {
            "description": "Content type must be application/json"
          },
          "429": {
            "description": "Shared agent quota exceeded"
          }
        },
        "security": [
          {
            "agentKey": []
          },
          {
            "mcpOAuth": [
              "receipts"
            ]
          }
        ]
      },
      "get": {
        "summary": "No standalone event stream",
        "responses": {
          "405": {
            "description": "Stateless transport accepts POST only"
          },
          "401": {
            "description": "Missing, invalid, expired or revoked credential",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer challenge with resource_metadata and receipts scope"
              }
            }
          }
        },
        "security": [
          {
            "agentKey": []
          },
          {
            "mcpOAuth": [
              "receipts"
            ]
          }
        ]
      },
      "delete": {
        "summary": "No persistent MCP transport session",
        "responses": {
          "405": {
            "description": "There is no transport session to terminate; revoke the agent key through group settings instead"
          },
          "401": {
            "description": "Missing, invalid, expired or revoked credential",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer challenge with resource_metadata and receipts scope"
              }
            }
          }
        },
        "security": [
          {
            "agentKey": []
          },
          {
            "mcpOAuth": [
              "receipts"
            ]
          }
        ]
      }
    },
    "/.well-known/oauth-protected-resource": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "get": {
        "summary": "OAuth protected-resource metadata",
        "description": "RFC 9728 canonical resource, authorization_servers and minimal receipts scope.",
        "security": [],
        "responses": {
          "200": {
            "description": "Resource metadata JSON"
          }
        }
      }
    },
    "/.well-known/oauth-protected-resource/api/mcp": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "get": {
        "summary": "OAuth protected-resource metadata",
        "description": "RFC 9728 canonical resource, authorization_servers and minimal receipts scope.",
        "security": [],
        "responses": {
          "200": {
            "description": "Resource metadata JSON"
          }
        }
      }
    },
    "/.well-known/oauth-authorization-server": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "get": {
        "summary": "OAuth authorization-server metadata",
        "description": "RFC 8414 issuer, endpoints, S256 and client authentication methods.",
        "security": [],
        "responses": {
          "200": {
            "description": "Authorization server metadata JSON"
          }
        }
      }
    },
    "/api/oauth/register": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "post": {
        "summary": "Register an MCP OAuth client",
        "description": "RFC 7591 dynamic registration; no workspace credentials. Public none or confidential post/basic. HTTPS callbacks or HTTP loopback only. Client metadata URLs are not fetched.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "redirect_uris"
                ],
                "properties": {
                  "client_name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "redirect_uris": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "token_endpoint_auth_method": {
                    "enum": [
                      "none",
                      "client_secret_post",
                      "client_secret_basic"
                    ]
                  },
                  "grant_types": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "authorization_code",
                        "refresh_token"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered client metadata, ID and optional one-time client secret"
          },
          "400": {
            "description": "Invalid client metadata"
          },
          "429": {
            "description": "Registration quota exceeded"
          }
        }
      }
    },
    "/api/oauth/authorize": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "get": {
        "summary": "Start browser authorization",
        "description": "Requires code response, S256 PKCE, registered callback and exact MCP resource. Redirects to first-party sign-in/consent; never automatically approves.",
        "security": [],
        "parameters": [
          {
            "in": "query",
            "name": "client_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "redirect_uri",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "response_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code_challenge",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code_challenge_method",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "resource",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "First-party consent page"
          },
          "400": {
            "description": "Invalid request; no unvalidated redirect"
          },
          "429": {
            "description": "Quota exceeded"
          }
        }
      }
    },
    "/api/oauth/token": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "post": {
        "summary": "Exchange an OAuth code or rotate refresh token",
        "description": "Client authentication must match registration. Code requires exact callback and S256 verifier. Resource must equal canonical MCP endpoint. Code/refresh replay revokes the grant. Access expires in 30 minutes; grant expires after 30 days.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "resource"
                ],
                "properties": {
                  "grant_type": {
                    "type": "string"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "code_verifier": {
                    "type": "string"
                  },
                  "redirect_uri": {
                    "type": "string"
                  },
                  "refresh_token": {
                    "type": "string"
                  },
                  "resource": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "access_token, token_type, expires_in, scope and optional refresh_token"
          },
          "400": {
            "description": "OAuth error"
          },
          "401": {
            "description": "Invalid confidential client authentication"
          },
          "429": {
            "description": "Quota exceeded"
          }
        }
      }
    },
    "/api/oauth/revoke": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "post": {
        "summary": "Revoke an OAuth grant",
        "description": "Client-authenticated RFC 7009 revocation. Either access or refresh token revokes the entire associated agent grant; unknown tokens return success.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "token_type_hint": {
                    "type": "string"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Revoked or unknown token"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid client"
          },
          "429": {
            "description": "Quota exceeded"
          }
        }
      }
    }
  }
}
