    "/expenses/void": {
      "post": {
        "operationId": "voidExpense",
        "summary": "Remove an own posted expense from balances",
        "description": "Soft-deletes the expense; retains its receipt, ID and history. Already voided expenses safely replay. Cannot restore an expense or modify manual expenses/other agents’ expenses. Use update_expense for corrections. Requires userConfirmed=true from explicit user instruction and expectedRevision from the latest read. The server relies on the agent to interpret conversational consent. Row locks and content revisions prevent overwriting changed state; identical outcomes return replayed=true. On 409 reread and review before retrying.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoidExpense"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated receipt or expense with revision and replayed boolean"
          },
          "400": {
            "description": "Invalid fields, missing confirmation or invalid split"
          },
          "401": {
            "description": "Invalid, expired or revoked credential"
          },
          "404": {
            "description": "Not found or outside the agent scope"
          },
          "409": {
